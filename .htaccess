# =============================================================
# MES系统知识库 —— Apache 根目录配置
# 适配 Apache 2.4（Rocky Linux 8+）
# 需确保 httpd.conf 中 AllowOverride All 已开启
#
# 目录访问保护采用「各目录内独立 .htaccess」的方式，
# 子目录部署（如 http://host/mes-kb/）同样生效。
#
# ©Yangzengrong 版权所有
# =============================================================

Options -Indexes
DirectoryIndex index.php

# ---------- 屏蔽说明/示例/备份等非运行文件 ----------
# README.md、nginx.conf.sample、*.sql / *.bak 会泄露内部目录结构与部署细节
<FilesMatch "\.(md|markdown|sample|sql|bak|log|sh|ini|yml|yaml|lock|zip|tar|gz|tgz|txt)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.bak[-.][0-9]+$">
    Require all denied
</FilesMatch>

# ---------- 前台伪静态 ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 已存在的文件 / 目录直接返回（静态资源、/admin、/install）
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 其余请求全部交给前台入口（/case/12、/search、/file/3/download …）
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# ---------- 安全响应头 ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

AddDefaultCharset UTF-8
